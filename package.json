{
  "name": "penta-public-sector-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:demo": "vite --mode demo",
    "build": "npm run build:web && npm run build:server",
    "build:web": "npm run check:env && npm run check:demo-exclusion && vite build && tsx scripts/check-demo-exclusion.ts --bundle",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:smoke": "playwright test e2e/smoke.spec.ts e2e/m2.spec.ts && playwright test e2e/m3.spec.ts && playwright test e2e/m4.spec.ts && playwright test e2e/m5.spec.ts && playwright test e2e/m6.spec.ts && playwright test e2e/m7.spec.ts",
    "check:demo-exclusion": "tsx scripts/check-demo-exclusion.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env server/db/migrate.ts",
    "db:migrate:test": "tsx --env-file-if-exists=.env server/db/migrate.ts --test",
    "db:seed": "tsx --env-file-if-exists=.env server/db/seed.ts",
    "db:seed:test": "tsx --env-file-if-exists=.env server/db/seed.ts --test",
    "db:reset": "tsx --env-file-if-exists=.env server/db/reset.ts",
    "documents:maintain": "tsx --env-file-if-exists=.env server/db/documentMaintenance.ts",
    "jobs:run": "tsx --env-file-if-exists=.env server/jobs/runOnce.ts",
    "preview": "vite preview",
    "evidence": "playwright test e2e/evidence.spec.ts && playwright test e2e/evidence-m3.spec.ts && playwright test e2e/evidence-m4.spec.ts && playwright test e2e/evidence-m5.spec.ts && playwright test e2e/evidence-m6.spec.ts",
    "check:env": "tsx scripts/check-env-example.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "connect-pg-simple": "10.0.0",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.0.3",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "framer-motion": "11.18.2",
    "helmet": "8.3.0",
    "lucide-react": "0.522.0",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.2",
    "sonner": "2.0.1",
    "tailwind-merge": "2.6.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/connect-pg-simple": "7.0.3",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/express-session": "1.18.2",
    "@types/node": "24.10.1",
    "@types/passport": "1.0.17",
    "@types/passport-local": "1.0.38",
    "@types/pg": "8.15.6",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "0.31.11",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.24",
    "postcss": "8.5.6",
    "supertest": "7.3.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  }
}
