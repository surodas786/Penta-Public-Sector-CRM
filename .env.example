# Penta CRM — local development configuration example.
# Copy to .env and adjust. NEVER commit a real .env, and never put production
# credentials, live commercial data or secrets in this file.
#
#   cp .env.example .env
#
# Node: see .nvmrc (Node 22 LTS or newer; developed and tested on Node 24).

# ---------------------------------------------------------------------------
# Runtime database connection (restricted application role).
# This role cannot run DDL and cannot UPDATE or DELETE audit_events.
# Host port 55432 is the docker-compose mapping; see docker-compose.yml.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://penta_app:penta_local_app@127.0.0.1:55432/penta_crm_dev

# Separate database used by the integration test suite. The harness refuses to
# run if this is missing, or if it resolves to the same database as DATABASE_URL.
TEST_DATABASE_URL=postgres://penta_app:penta_local_app@127.0.0.1:55432/penta_crm_test

# ---------------------------------------------------------------------------
# Migration connection (schema owner). Used only by `npm run db:migrate`.
# ---------------------------------------------------------------------------
MIGRATION_DATABASE_URL=postgres://penta_migrator:penta_local_migrator@127.0.0.1:55432/penta_crm_dev
TEST_MIGRATION_DATABASE_URL=postgres://penta_migrator:penta_local_migrator@127.0.0.1:55432/penta_crm_test

# ---------------------------------------------------------------------------
# Passwords used by docker-compose when it first initialises the data volume.
# Local synthetic values only.
# ---------------------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=penta_local_superuser
PENTA_MIGRATOR_PASSWORD=penta_local_migrator
PENTA_APP_PASSWORD=penta_local_app

# ---------------------------------------------------------------------------
# Server
#
# Windows note: Hyper-V, WSL and Docker Desktop reserve blocks of TCP ports,
# and binding one fails with EACCES even though it looks free. Check with
#   netsh interface ipv4 show excludedportrange protocol=tcp
# and pick a PORT outside those ranges. 4800 is outside the usual blocks.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4800

# Trusted browser origin. Used for CSRF origin validation and CORS.
APP_ORIGIN=http://localhost:5173

# Session signing secret. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-32-byte-random-hex-value
CSRF_SECRET=replace-me-with-a-different-32-byte-random-hex-value

# Session lifetimes (minutes). Defaults follow SEC-031.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=720

# Request log (NFR-003): one JSON line per request with request id, method,
# path (no query string), status and duration — never bodies, headers or
# cookies (SEC-032). all | errors (5xx and requests over 2 s) | off
REQUEST_LOG=errors

# ---------------------------------------------------------------------------
# Documents (SEC-010). Production storage and scanning are NOT yet decided;
# see docs/adr/0006. These settings are for local development only.
#
# DOCUMENT_STORAGE_DIR  private directory for uploaded files. Never inside
#                       dist/ or public/. Ignored by git (var/).
# DOCUMENT_SCANNER      none  files are stored but stay "pending" and can
#                             never be downloaded (the safe default)
#                       test  a deterministic TEST scanner for development:
#                             it flags the EICAR test string and nothing else.
#                             It is not malware scanning, and the server
#                             refuses to start with it in production.
# DOCUMENT_MAX_UPLOAD_MB       per-file limit, default 25
# DOCUMENT_UPLOAD_TTL_MINUTES  unfinalized uploads are removed after this
# ---------------------------------------------------------------------------
DOCUMENT_STORAGE_DIR=./var/documents
DOCUMENT_SCANNER=test
DOCUMENT_MAX_UPLOAD_MB=25
DOCUMENT_UPLOAD_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Background jobs (FR-090, FR-083, NFR-003): notification scans, queued CSV
# exports and housekeeping run from the durable background_jobs table.
#
# JOBS_ENABLED            true: the API process runs the worker. false: run
#                         `npm run jobs:run` from a scheduler instead (e.g.
#                         every few minutes); notifications and exports wait
#                         until it runs.
# JOBS_POLL_SECONDS       how often the in-process worker looks for due work
# REPORT_EXPORT_TTL_HOURS a prepared CSV can be downloaded for this long
# REPORT_EXPORT_MAX_ROWS  an export reaching this many rows is refused, never
#                         truncated
# ---------------------------------------------------------------------------
JOBS_ENABLED=true
JOBS_POLL_SECONDS=15
REPORT_EXPORT_TTL_HOURS=24
REPORT_EXPORT_MAX_ROWS=50000

# ---------------------------------------------------------------------------
# Backup and restore (NFR-002); see docs/operations/backup-and-restore.md.
#
# BACKUP_ENCRYPTION_KEY  64 hex characters (32 bytes). Every backup file is
#                        encrypted with it (AES-256-GCM). Keep it in the secret
#                        store, NEVER beside the backups, never in git. Left
#                        empty here on purpose: backups refuse to run without it.
# BACKUP_DIR             where `npm run ops:backup` writes (local default)
# PG_TOOLS_CONTAINER     run pg_dump/pg_restore inside this docker container,
#                        so the client matches the server's major version.
#                        Empty: use pg_dump/pg_restore from PATH.
# ---------------------------------------------------------------------------
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=./var/backups
PG_TOOLS_CONTAINER=penta-crm-postgres

# ---------------------------------------------------------------------------
# Synthetic seed passwords. Development and test only.
# `npm run db:seed` refuses to run when NODE_ENV=production.
#
# Quote any value containing '#': Node's --env-file parser treats an unquoted
# '#' as the start of an inline comment and silently truncates the value.
# `npm run check:env` fails the build if that happens again.
# ---------------------------------------------------------------------------
SEED_DEFAULT_PASSWORD="Synthetic-Dev-2026"

# ---------------------------------------------------------------------------
# Frontend (Vite). VITE_* values are PUBLIC — never put a secret here.
# VITE_DEMO_MODE=true serves the original synthetic MagicPatterns demo with
# browser-local storage. Production builds fail if this is enabled.
# ---------------------------------------------------------------------------
VITE_DEMO_MODE=false
