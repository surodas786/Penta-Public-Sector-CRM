# Vite mode file for the isolated synthetic demo build (`npm run dev:demo`).
# This mode serves the original approved MagicPatterns prototype with
# browser-local storage and fictional data. It never connects to the API,
# never reaches PostgreSQL, and must never be used for real sales data.
#
# No secrets belong in this file: every VITE_* value is public.
VITE_DEMO_MODE=true
