{
  "compilerOptions": {
    "target": "ES2022",
    // Browser smoke tests run in Node but evaluate callbacks inside the page,
    // so they legitimately reference DOM globals. Server code must not, which
    // is why this sits in its own project rather than widening tsconfig.server.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["e2e", "playwright.config.ts"]
}
